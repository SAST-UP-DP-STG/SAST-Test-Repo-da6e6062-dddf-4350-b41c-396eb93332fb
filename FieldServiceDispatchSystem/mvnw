#!/usr/bin/env sh
set -eu

MVNW_HOME=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$MVNW_HOME/.mvn/wrapper/maven-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  mkdir -p "$MVNW_HOME/.mvn/wrapper"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$URL" -o "$WRAPPER_JAR"
  else
    wget -q "$URL" -O "$WRAPPER_JAR"
  fi
fi

if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVA_EXE="$JAVA_HOME/bin/java"
else
  JAVA_EXE="java"
fi

exec "$JAVA_EXE" -classpath "$WRAPPER_JAR" -Dmaven.multiModuleProjectDirectory="$MVNW_HOME" org.apache.maven.wrapper.MavenWrapperMain "$@"
